rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User-isolated private domain
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      match /calendarSyncJobs/{jobId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Alumnos collection
      match /alumnos/{alumnoId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(alumnoId);
      }

      // Clases collection
      match /clases/{claseId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(claseId);
      }

      // Tocatas collection (Fechas DJ)
      match /tocatas/{tocataId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(tocataId);
      }

      // Notas de alumnos
      match /notas/{notaId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(notaId);
      }

      // Notas rápidas (Setlists, recordatorios pedagógicos, ideas)
      match /notasRapidas/{notaId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(notaId);
      }

      // Configuraciones y preferencias
      match /configuracion/{configId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(configId);
      }
    }
  }
}

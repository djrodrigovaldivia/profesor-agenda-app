{
  "entities": {
    "Alumno": {
      "title": "Alumno",
      "description": "Ficha de alumno de música / DJ",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nombre": { "type": "string", "maxLength": 120 },
        "nivel": { "type": "string", "enum": ["básico", "intermedio", "avanzado"] },
        "telefono": { "type": "string", "maxLength": 50 },
        "descripcion": { "type": "string", "maxLength": 1000 },
        "activo": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "nombre", "nivel", "activo", "createdAt", "updatedAt"]
    },
    "Clase": {
      "title": "Clase",
      "description": "Sesión pedagógica o clase de música / mentoría",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "alumnoId": { "type": "string", "maxLength": 128 },
        "tipo": { "type": "string", "enum": ["alma", "escalera", "dj", "sokolov"] },
        "fecha": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "horaInicio": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$", "maxLength": 5 },
        "horaFin": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$", "maxLength": 5 },
        "tema": { "type": "string", "maxLength": 200 },
        "notas": { "type": "string", "maxLength": 2000 },
        "estado": { "type": "string", "enum": ["programada", "realizada", "cancelada"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "alumnoId", "tipo", "fecha", "horaInicio", "horaFin", "tema", "estado", "createdAt", "updatedAt"]
    },
    "Tocata": {
      "title": "Tocata",
      "description": "Fecha o presentación DJ en vivo",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "titulo": { "type": "string", "maxLength": 200 },
        "fecha": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "horaInicio": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$", "maxLength": 5 },
        "horaFin": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$", "maxLength": 5 },
        "proyecto": { "type": "string", "enum": ["Rodrigo Valdivia", "Sokolov", "Área 51", "Otro"] },
        "lugar": { "type": "string", "maxLength": 200 },
        "ciudad": { "type": "string", "maxLength": 100 },
        "direccion": { "type": "string", "maxLength": 300 },
        "contacto": { "type": "string", "maxLength": 200 },
        "honorarios": { "type": "number" },
        "estado": { "type": "string", "enum": ["pendiente", "confirmada", "cancelada", "realizada"] },
        "notas": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "titulo", "fecha", "horaInicio", "horaFin", "proyecto", "estado", "createdAt", "updatedAt"]
    },
    "NotaAlumno": {
      "title": "NotaAlumno",
      "description": "Nota de seguimiento de un alumno",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "alumnoId": { "type": "string", "maxLength": 128 },
        "texto": { "type": "string", "maxLength": 2000 },
        "fecha": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "alumnoId", "texto", "fecha", "createdAt", "updatedAt"]
    },
    "Preferencias": {
      "title": "Preferencias",
      "description": "Preferencias de usuario de la agenda",
      "type": "object",
      "properties": {
        "recordatoriosActivos": { "type": "boolean" },
        "recordatorios": { "type": "string", "enum": ["un_dia_antes", "mismo_dia", "ambos"] },
        "proximaVistaDias": { "type": "number", "enum": [7, 30] }
      },
      "required": ["recordatoriosActivos", "recordatorios", "proximaVistaDias"]
    },
    "MetadataConfig": {
      "title": "MetadataConfig",
      "description": "Metadato de migración o configuración del usuario",
      "type": "object",
      "properties": {
        "migratedAt": { "type": "string", "maxLength": 64 },
        "source": { "type": "string", "maxLength": 64 },
        "version": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}/alumnos/{alumnoId}": {
      "schema": { "$ref": "#/entities/Alumno" },
      "description": "Colección privada de alumnos del usuario"
    },
    "/users/{userId}/clases/{claseId}": {
      "schema": { "$ref": "#/entities/Clase" },
      "description": "Colección privada de clases del usuario"
    },
    "/users/{userId}/tocatas/{tocataId}": {
      "schema": { "$ref": "#/entities/Tocata" },
      "description": "Colección privada de tocatas / Fechas DJ del usuario"
    },
    "/users/{userId}/notas/{notaId}": {
      "schema": { "$ref": "#/entities/NotaAlumno" },
      "description": "Colección privada de notas de alumnos del usuario"
    },
    "/users/{userId}/configuracion/{configId}": {
      "schema": { "$ref": "#/entities/Preferencias" },
      "description": "Documentos de configuración y preferencias del usuario"
    }
  }
}
